{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/auto-format.sh",
            "shell": "bash",
            "timeout": 30,
            "statusMessage": "Auto-formatting..."
          }
        ]
      }
    ]
  }
}
