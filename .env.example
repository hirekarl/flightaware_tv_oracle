# Copy this file to .env and fill in values before running the backend.
# .env is gitignored — never commit real credentials.

# instructor.from_provider("google/...") reads GOOGLE_API_KEY automatically.
# Get your key at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_gemini_api_key_here

# Comma-separated list of allowed CORS origins for the FastAPI backend.
# Local dev default is the Vite dev server. Add staging/prod URLs as needed.
CORS_ORIGINS=http://localhost:5173
